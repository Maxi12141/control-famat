{
  "name": "control-famat",
  "private": true,
  "version": "1.0.0",
  "description": "Controlador Famat — panel de pedidos, stock y precios",
  "author": "Famat",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite & electron .",
    "electron:build": "vite build && electron-builder --win portable",
    "electron:pack": "vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.famat.control",
    "productName": "Control Famat",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Control-Famat-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "Control-Famat-${version}-portable.${ext}"
    }
  }
}
